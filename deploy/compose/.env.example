# Copy to .env and replace every value before starting the stack.

# ENCRYPTION_KEY must be exactly 32 bytes. It encrypts certificate private keys
# at rest; losing it makes stored certificates unreadable.
ENCRYPTION_KEY=change-me-to-32-bytes-exactly!!!

# SESSION_KEY signs session cookies. Changing it signs everyone out.
SESSION_KEY=change-me-to-a-long-random-string

# Shared secret between the api and the proxy's internal event stream.
INTERNAL_STREAM_TOKEN=change-me-to-a-random-string

POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# The first administrator, created on first start only.
# A username is letters, digits, dots, dashes or underscores.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-12-chars

# Ports published on the host.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
WEB_PORT=8081

# Set to true when the UI is served over HTTPS.
API_SECURE_COOKIES=false

# Optional MaxMind databases for country and network enrichment. Mount them into
# the proxy container and point these at the mounted paths.
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# Spool watermark, in bytes. Reached only when ClickHouse is unavailable.
SPOOL_MAX_BYTES=10737418240

# Set true to stall requests rather than drop events when the queue is full.
PIPELINE_BLOCK_ON_FULL=false
