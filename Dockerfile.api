FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10002 api
COPY --from=build /out/api /usr/local/bin/api
RUN mkdir -p /data/blobs && chown -R api:api /data
USER api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/api"]
